{
  "expo": {
    "name": "3D Nexus",
    "slug": "3d-nexus",
    "version": "1.0.0",
    "owner": "asilturk07",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0b"
    },
    "android": {
      "package": "com.nexus3d.app",
      "permissions": ["READ_MEDIA_IMAGES", "INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0b"
      }
    },
    "plugins": [
      ["expo-media-library", {
        "photosPermission": "3D Nexus, görsellerinizi göstermek için medya arşivinize erişir.",
        "savePhotosPermission": "3D Nexus, ürettiğiniz görselleri galerinize kaydetmek için izin ister."
      }],
      "expo-document-picker",
      "expo-file-system"
    ]
  }
}